import java.util.*;
public class Short{
    public static void main(String[] args) {
        String path = "NSEWW";
        System.out.println(sp(path));

    }
    public static float sp(String path){
        int x=0;
        int y=0;
        for(int i=0;i<path.length();i++){
            char dir = path.charAt(i);
            switch(dir){
                case 'N': y++; break;
                case 'S': y--; break;
                case 'E': x++; break;
                case 'W': x--; break;
            }
        }
        return (float)Math.sqrt(x*x + y*y);
    }
}
